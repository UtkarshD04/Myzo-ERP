MONGO_URI=mongodb://localhost:27017/solar-park
# In production (KVM2), point this at the website's MongoDB container on the
# same internal Docker network instead, keeping the /solar-park database name
# — e.g. mongodb://<user>:<pass>@<internal-host>:27017/solar-park?authSource=admin&directConnection=true
# Get the real internal host/user/pass from the hosting panel; never commit them here.
PORT=8080

# Generate a strong, unique secret per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the same secret across dev/staging/production, and never commit the real value.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Set to false to pause creation of new notifications app-wide (temporary
# product switch — existing notifications and the mark-read/delete
# endpoints keep working either way).
NOTIFICATIONS_ENABLED=true

CALENDARIFIC_API_KEY=
HOLIDAY_COUNTRY=IN
SMTP_USER=
SMTP_PASS=

# Base URL of the deployed frontend, used to build the link sent in
# forgot-password emails (e.g. https://erp.yourcompany.com). Defaults to
# http://localhost:3000 when unset.
FRONTEND_URL=http://localhost:3000

# Restrict in production to the exact frontend origin, e.g. https://erp.yourcompany.com
# Defaults to * (any origin) when unset.
CORS_ORIGIN=
